{
  "name": "ha-family-board-card",
  "version": "0.35.0",
  "description": "Family calendar / who-is-where board for Home Assistant",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "preview": "python3 -m http.server 8931",
    "check:browser": "node tools/preview/check.mjs",
    "check:shared": "node tools/check-shared.mjs",
    "screenshots": "node tools/preview/screenshots.mjs"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "axe-core": "^4.14.0",
    "custom-card-helpers": "^2.1.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "rollup": "^4.68.3",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
