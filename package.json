{
  "name": "ha-family-board-card",
  "version": "0.28.0",
  "description": "Family calendar / who-is-where board for Home Assistant",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "preview": "python3 -m http.server 8931",
    "check:browser": "node tools/preview/check.mjs",
    "check:shared": "node tools/check-shared.mjs"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "custom-card-helpers": "^2.0.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.2.5",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
